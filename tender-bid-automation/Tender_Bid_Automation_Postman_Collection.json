              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/tenders/upload",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tenders", "upload"]
            },
            "description": "Upload a RFP document (PDF/DOCX). Backend parses text, extracts key tender metadata, calculates Go/No-Go score, and generates initial compliance & BOQ matrix."
          },
          "response": []
        },
