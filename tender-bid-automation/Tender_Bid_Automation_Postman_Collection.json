    {
      "name": "01. Tenders Management",
      "item": [
        {
          "name": "Get All Tenders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tenders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tenders"]
            },
            "description": "Fetch all tenders listed in the system with their status, scores, and metadata."
          },
          "response": []
        },
        {
          "name": "Get Tender By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tenders/{{tenderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tenders", "{{tenderId}}"]
            },
            "description": "Fetch complete details of a specific tender by its ID."
          },
          "response": []
        },
        {
          "name": "Upload & AI Ingest Tender Document",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "document",
                  "type": "file",
                  "description": "PDF, DOCX, or TXT tender RFP document file (Max: 50MB)"
