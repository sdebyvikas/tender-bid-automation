                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenderNumber\": \"NIT-2026-IT-901\",\n  \"title\": \"Smart City Surveillance & AI Analytics System\",\n  \"organization\": \"Delhi Smart City Mission Ltd\",\n  \"category\": \"Smart City / Surveillance / IoT\",\n  \"portal\": \"GeM Portal\",\n  \"estimatedValueINR\": 250000000,\n  \"estimatedValueDisplay\": \"₹25.00 Cr\",\n  \"emdAmountINR\": 500000,\n  \"emdDisplay\": \"₹5.00 Lakhs\",\n  \"tenderFeeINR\": 10000,\n  \"publishDate\": \"2026-09-24\",\n  \"submissionDeadline\": \"2026-10-15T15:00:00\",\n  \"preBidMeetingDate\": \"2026-09-30T11:00:00\",\n  \"scopeSummary\": \"Supply, installation, cloud AI video analytics, command and control center setup for 500+ edge cameras.\",\n  \"eligibilityCriteria\": {\n    \"minAnnualTurnoverINR\": 120000000,\n    \"minExperienceYears\": 5,\n    \"requiredCertifications\": [\"ISO 9001\", \"ISO 27001\", \"CMMI Level 3\"]\n  }\n}"
